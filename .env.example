# Copia este archivo a .env y completa los valores. .env NUNCA se sube a git.

# Cadena de conexión Postgres de Supabase (Project Settings > Database > Connection string, pooler).
# Con el pooler de Supabase en el puerto 5432 el código usa automáticamente el modo transacción (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secreto largo y aleatorio (>= 32 chars): firma de cookies de sesión y token interno entre servicios.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcionales
# SCRAPER_MODE=auto        # auto (real con fallback a mock) | real | mock
# SYNC_INTERVAL_SECONDS=900
